# CareSync backend environment variables
# Copy this file to .env and replace [YOUR-PASSWORD] with your Supabase
# database password (Supabase Dashboard -> Project Settings -> Database).
# NEVER commit the real .env file to version control.

DATABASE_URL=postgresql://postgres.pcysslzbzzsefeujyykt:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase project (used for Auth / REST API integration)
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-PUBLISHABLE-KEY]
# Legacy alias: SUPABASE_ANON_KEY is used instead if set.

# Comma-separated origins allowed by CORS (the frontend dev server by default)
ALLOWED_ORIGINS=http://localhost:5173